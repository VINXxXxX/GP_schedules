<?xml version="1.0" encoding="utf-8"?>
<!-- Next round: big city name, 4-box countdown, live / next status -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/heroCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="18dp"
    android:layout_marginEnd="16dp"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/heroWatermark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="-20dp"
        android:layout_marginEnd="-6dp"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:textSize="150sp"
        tools:text="01" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/heroChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:textSize="11sp"
                tools:text="NEXT UP · 5–7 MAR" />

            <!-- Track weather, race week only -->
            <TextView
                android:id="@+id/heroWeather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:drawablePadding="5dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="9dp"
                android:paddingBottom="3dp"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="32° · 10% rain"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/heroCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxLines="2"
            android:textSize="56sp"
            tools:text="BURIRAM" />

        <TextView
            android:id="@+id/heroCountry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="24sp"
            tools:text="THAILAND" />

        <TextView
            android:id="@+id/heroTrack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            tools:text="CHANG INTERNATIONAL CIRCUIT" />

        <LinearLayout
            android:id="@+id/countdownRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <include android:id="@+id/cd1" layout="@layout/item_countdown_box" />
            <include android:id="@+id/cd2" layout="@layout/item_countdown_box" />
            <include android:id="@+id/cd3" layout="@layout/item_countdown_box" />
            <include android:id="@+id/cd4" layout="@layout/item_countdown_box" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/heroStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                tools:text="First session FP1 · Fri 09:15" />

            <TextView
                android:id="@+id/heroAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Sessions ›"
                android:textSize="13sp"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
