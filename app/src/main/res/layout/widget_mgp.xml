<?xml version="1.0" encoding="utf-8"?>
<!--
    4×2 MotoGP widget (Pit Wall). RemoteViews-safe views only
    (FrameLayout / LinearLayout / TextView / ImageView / Chronometer / ProgressBar).

    R01  THAILAND · 5–7 MAR                🔔 15m   ● LIVE
    BURIRAM                              FP1 ENDS IN
    ● FP1 LIVE · NEXT FP2 13:30             00:25:12
    ───────────────────────────────────────────────
    FRI 05        SAT 06            SUN 07
    FP1 09:15     FP3 08:40         SIGHT 13:20
    FP2 13:30     Q1 09:20 …        RACE 13:30
    NEXT RND · LUSAIL 12 MAR                  1 / 22
    ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:paddingStart="14dp"
    android:paddingTop="11dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp"
    tools:ignore="UselessParent">

    <!-- Big round number watermark -->
    <TextView
        android:id="@+id/watermark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-condensed"
        android:includeFontPadding="false"
        android:text="01"
        android:visibility="gone"
        android:textColor="#17171A"
        android:textSize="88sp"
        android:textStyle="bold"
        tools:ignore="HardcodedText" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/round_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip_round"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:letterSpacing="0.06"
                android:paddingStart="6dp"
                android:paddingTop="3dp"
                android:paddingEnd="6dp"
                android:paddingBottom="3dp"
                android:text="R--"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/header_meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:textColor="#C6C6CE"
                android:textSize="12sp" />
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeStepGranularity="0.5sp"
                tools:targetApi="o"

            <ImageView
                android:id="@+id/weather_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wx_sun"
                android:visibility="gone" />

            <TextView
                android:id="@+id/weather_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#E8E8EC"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- HERO: city + status line | timer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-condensed"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="MotoGP"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="20sp"
                android:autoSizeMaxTextSize="32sp"
                android:autoSizeStepGranularity="0.5sp"
                tools:targetApi="o"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/hero_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.06"
                    android:maxLines="1"
                    android:textColor="#FF6B60"
                    android:textSize="13sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="13sp"
                android:autoSizeStepGranularity="0.5sp"
                tools:targetApi="o"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/hero_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:textColor="#C6C6CE"
                    android:textSize="11sp" />
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeStepGranularity="0.5sp"
                tools:targetApi="o"

                <Chronometer
                    android:id="@+id/hero_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:countDown="true"
                    android:fontFamily="sans-serif-condensed"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/hero_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- TRACK (tall size only) -->
        <TextView
            android:id="@+id/widget_track"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:textColor="#B0B0B8"
            android:textSize="11sp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="5dp"
            android:background="#2E2E34" />

        <!-- DAY COLUMNS (race week) or NEXT ROUNDS (off week) -->
        <LinearLayout
            android:id="@+id/days_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView android:id="@+id/day_1" style="@style/WidgetDayColumn" />
            <TextView android:id="@+id/day_2" style="@style/WidgetDayColumn" />
            <TextView android:id="@+id/day_3" style="@style/WidgetDayColumn" />
            <TextView android:id="@+id/day_4" style="@style/WidgetDayColumn" />
        </LinearLayout>

        <!-- ONE-LINE AGENDA (short size only) -->
        <TextView
            android:id="@+id/agenda"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:textColor="#D4D4D8"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- FOOTER -->
        <LinearLayout
            android:id="@+id/footer_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/footer_left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:textColor="#B0B0B8"
                android:textSize="11sp" />
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeStepGranularity="0.5sp"
                tools:targetApi="o"

            <TextView
                android:id="@+id/footer_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="#B0B0B8"
                android:textSize="11sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/season_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:max="22"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress" />
    </LinearLayout>
</FrameLayout>
