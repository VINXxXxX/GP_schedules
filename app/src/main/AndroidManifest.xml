<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- Exact alarms: widget flips to LIVE / next session on the minute.
         Android 13+: USE_EXACT_ALARM is granted automatically (fine for a personal sideloaded app;
         Play Store would restrict it). Android 12: SCHEDULE_EXACT_ALARM. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required to reschedule alarms after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />



    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Schedule">

        <!-- Main screen. Its LAUNCHER entry is in src/phone (the TV app opens it from SETTINGS) -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- "Open with GP Schedule" for a schedule .json file -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>

        <!-- One round's sessions (from the list, a widget tap or a notification) -->
        <activity
            android:name=".RaceDetailActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Boot receiver (MUST be exported=true for system broadcast) -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>

        <!-- Notifications -->
        <receiver
            android:name=".RaceNotificationReceiver"
            android:exported="false"/>

        <!-- Time / timezone change receiver -->
        <receiver
            android:name=".TimeChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_CHANGED"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
                <action android:name="android.intent.action.DATE_CHANGED"/>
            </intent-filter>
        </receiver>
        <receiver
            android:name=".WidgetRefreshReceiver"
            android:exported="false"/>
        <receiver
            android:name=".WidgetUpdateReceiver"
            android:exported="false" />

    </application>
</manifest>
